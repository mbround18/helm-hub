# Example Dotenv file for Helm Hub

JWT_SECRET=changeme
DATABASE_URL=postgres://helmhub:helmhub@localhost:5432/helmhub
DB_PASSWORD=helmhub

# ── Admin bootstrap ───────────────────────────────────────────────────────────
# Username that is always treated as an admin at runtime — no DB write needed.
# Set this to your operator account on first deploy.
# ADMIN_USERNAME=

# ── Storage quotas ────────────────────────────────────────────────────────────
# Global default per-user storage quota in GB (default: 5 GB).
# Override per-user via PUT /api/admin/users/:id/quota.
# DEFAULT_STORAGE_QUOTA_GB=5

# ── Observability (OpenTelemetry & Grafana Faro) ─────────────────────────────
# OTLP Collector endpoint (gRPC or HTTP).
# gRPC: http://localhost:4317
# HTTP: http://localhost:4318/v1/traces
# OTEL_COLLECTOR_ENDPOINT=

# Internal URL for the Faro collector (accessible from the backend).
# If not set, defaults to OTEL_COLLECTOR_ENDPOINT.
# INTERNAL_FARO_URL=http://otel-collector:12347/collect

# Grafana Faro Frontend Toggle.
# If VITE_FARO_URL is set, the frontend will enable Faro and proxy through the backend.
# Set to "enabled" or a dummy string to activate.
# VITE_FARO_URL=enabled

# ── GitHub OAuth App (optional) ──────────────────────────────────────────────
# Create an OAuth App at https://github.com/settings/developers
# Set the callback URL to: https://<your-domain>/api/auth/github/callback
#
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=https://<your-domain>/api/auth/github/callback