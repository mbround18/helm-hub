DATABASE_URL=helm-hub.db
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRY_HOURS=24
CHARTS_STORAGE_PATH=./storage/charts
TEMP_UPLOAD_DIR=/tmp
HOST=0.0.0.0
PORT=3000
RUST_LOG=helm_hub_backend=debug,tower_http=debug

# ClamAV — set CLAMAV_ENABLED=false to skip scanning in local dev
CLAMD_SOCKET=/var/run/clamav/clamd.ctl
CLAMAV_ENABLED=false
